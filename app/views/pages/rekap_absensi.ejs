<div class="row">
   <div class="col-12">
      <div class="page-title-box d-sm-flex align-items-center justify-content-between">
         <h4 class="mb-sm-0">Rekap Absensi</h4>

         <div class="page-title-right">
            <ol class="breadcrumb m-0">
               <li class="breadcrumb-item active">Absensi</li>
               <li class="breadcrumb-item active">Rekap Absensi</li>
            </ol>
         </div>

      </div>
   </div>
</div>

<div class="row">
   <div class="col-md-6-lg-12">
      <div class="card">
         <div class="card-body">
            <div class="row d-flex justify-content-center">
               <div class="col-md-4 text-center">
                  <label for="flatpickr">Periode</label>
                  <div class="input-group">
                     <span class="input-group-text bg-success"><i class="bx bx-calendar text-white"></i></span>
                     <input class="form-control" type="text" id="flatpickr" name="periode">
                  </div>
               </div>
            </div>
         </div>
      </div>
   </div>

   <div class="col-md-6-lg-12" id="tableRekap">
   </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const periodeInput = document.getElementById('flatpickr');
    const container = document.querySelector('#tableRekap');

    flatpickr("#flatpickr", {
      disableMobile: "true",
      plugins: [
        new monthSelectPlugin({
          shorthand: true,
          dateFormat: "m-Y",
          altFormat: "F Y"
        })
      ]
    });

    periodeInput.addEventListener("change", async function () {
      const response = await fetch('/rekap-absensi/get-data/' + periodeInput.value);
      const data = await response.json();

      if (data.success) {
        renderTable(data.dataRekap, data.weekdays, data.kelasKeys);
      }
    });

    function renderTable(dataRekap, weekdays, kelasKeys) {
      let html = '';
      kelasKeys.forEach(kelas => {
        html += `
          <div class="card mt-3">
            <div class="card-header">
              <h5 class="card-title mb-0">Kelas ${kelas.replace(/_/g, ' ').toUpperCase()}</h5>
            </div>
            <div class="card-body">
              <div class="table-responsive">
                <table class="display table table-nowrap table-hover table-bordered table-striped-columns" id="#tableRekapAbsensi">
                  <thead>
                    <tr>
                      <th rowspan="2">NO</th>
                      <th rowspan="2">NAMA</th>
                      <th rowspan="2">NISN</th>
                      <th colspan="${weekdays.length * 2}">TANGGAL</th>
                    </tr>
                    <tr>
                      ${weekdays.map(t => `<th colspan="2">${new Date(t).getDate()}</th>`).join('')}
                    </tr>
                    <tr>
                      <th colspan="3"></th>
                      ${weekdays.map(() => `<th>H</th><th>P</th>`).join('')}
                    </tr>
                  </thead>
                  <tbody>
                    ${dataRekap[kelas].map((row, idx) => {
                      return `
                        <tr>
                          <td id="no_index">${idx + 1}</td>
                          <td class="text-start">${row.siswa.nama_lengkap}</td>
                          <td>${row.siswa.nisn}</td>
                          ${weekdays.map(t => {
                            const hadir = row.absensi.find(log =>
                              log.status_siswa === 'hadir' &&
                              new Date(log.created_at).toDateString() === new Date(t).toDateString()
                            );
                            const pulang = row.absensi.find(log =>
                              log.status_siswa === 'pulang' &&
                              new Date(log.created_at).toDateString() === new Date(t).toDateString()
                            );
                            return `
                              <td class="text-center"><input type="checkbox" class="form-check-input checkbox-hadir" ${hadir ? 'checked' : ''} disabled /></td>
                              <td class="text-center"><input type="checkbox" class="form-check-input checkbox-pulang" ${pulang ? 'checked' : ''} disabled /></td>
                            `;
                          }).join('')}
                        </tr>
                      `;
                    }).join('')}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        `;
      });
      container.innerHTML = html;
    }
  });
</script>
