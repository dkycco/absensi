<div class="row">
   <div class="col-12">
      <div class="page-title-box d-sm-flex align-items-center justify-content-between">
         <h4 class="mb-sm-0">Rekap Absensi</h4>

         <div class="page-title-right">
            <ol class="breadcrumb m-0">
               <li class="breadcrumb-item active">Absensi</li>
               <li class="breadcrumb-item active">Rekap Absensi</li>
            </ol>
         </div>

      </div>
   </div>
</div>

<div class="row mb-4">
   <div class="col-md-4">
      <div>
         <label class="form-label mb-0">Bulan</label>
         <input type="text" class="form-control">
      </div>
   </div>
</div>

<div class="row">
   <div class="col-md-6-lg-12">
      <% Object.keys(dataRekap).forEach(kelas => { %>
         <div class="card">
            <div class="card-header">
               <h5 class="card-title mb-0">Kelas <%= kelas.replace(/_/g, ' ').toUpperCase() %></h5>
            </div>
            <div class="card-body">
               <div class="row g-4 mb-3">
                  <div class="table-responsive">
                     <table id="tableRekapAbsensi" class="display table table-nowrap table-hover table-bordered">
                        <thead>
                           <tr>
                              <th rowspan="2">NO</th>
                              <th rowspan="2">NAMA</th>
                              <th rowspan="2">NISN</th>
                              <th colspan="<%= weekdays.length * 2 %>">TANGGAL</th>
                           </tr>
                           <tr>
                              <% weekdays.forEach(tgl => { %>
                              <th colspan="2"><%= tgl.getDate() %></th>
                              <% }) %>
                           </tr>
                           <tr>
                              <th colspan="3"></th>
                              <% weekdays.forEach(tgl => { %>
                              <th>H</th>
                              <th>P</th>
                              <% }) %>
                           </tr>
                        </thead>
                        <tbody>
                           <% dataRekap[kelas].forEach((siswa, index) => { %>
                              <tr>
                                 <td id="no"><%= index + 1 %></td>
                                 <td class="text-start"><%= siswa.siswa.nama_lengkap %></td>
                                 <td><%= siswa.siswa.nisn %></td>

                                 <% weekdays.forEach(tgl => { 
                                    const hadir = absenLogs.find(log => 
                                       log.nisn === siswa.siswa.nisn &&
                                       log.status_siswa === 'hadir' &&
                                       new Date(log.created_at).toDateString() === tgl.toDateString()
                                    );

                                    const pulang = absenLogs.find(log => 
                                       log.nisn === siswa.siswa.nisn &&
                                       log.status_siswa === 'pulang' &&
                                       new Date(log.created_at).toDateString() === tgl.toDateString()
                                    );
                                 %>
                                    <td class="text-center">
                                       <input type="checkbox" 
                                          class="form-check-input checkbox-hadir" 
                                          <%= hadir ? 'checked' : '' %> 
                                          disabled
                                       />
                                    </td>
                                    <td class="text-center">
                                       <input type="checkbox" 
                                          class="form-check-input checkbox-pulang" 
                                          <%= pulang ? 'checked' : '' %> 
                                          disabled
                                       />
                                    </td>
                                 <% }) %>
                              </tr>
                           <% }) %>
                        </tbody>
                     </table>
                  </div>
               </div>
            </div>
         </div>
      <% }) %>
   </div>
</div>

<script>
   document.addEventListener('DOMContentLoaded', () => {
      const idTable = 'tableRekapAbsensi';
      const table = document.getElementById(idTable);

      $('.select2').select2()
   });
</script>