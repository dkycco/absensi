<div class="row">
   <div class="col-12">
      <div class="page-title-box d-sm-flex align-items-center justify-content-between">
         <h4 class="mb-sm-0">Absensi Sekolah</h4>

         <div class="page-title-right">
            <ol class="breadcrumb m-0">
               <li class="breadcrumb-item active">Absensi</li>
               <li class="breadcrumb-item active">Absensi Sekolah</li>
            </ol>
         </div>

      </div>
   </div>
</div>

<div class="row">
   <div class="col-md-6-lg-12">
      <div class="card">
         <div class="card-header">
            <h5 class="card-title mb-0">Absensi Sekolah</h5>
         </div>
         <div class="card-body">
            <div class="row g-4 mb-3">
               <div class="col-md-6">
                  <div>
                     <button type="button" class="btn btn-success" id="btnAbsensiManual">
                        <i class="ri-add-line align-bottom me-1"></i> Absensi Manual
                     </button>
                  </div>
               </div>
               <table id="tableLogAbsensi" class="table nowrap align-middle" style="width:100%">
                  <thead>
                     <tr>
                        <th>No</th>
                        <th>ID Sidik Jari</th>
                        <th>Nama Lengkap</th>
                        <th>Kelas</th>
                        <th>Waktu</th>
                        <th>Status Absensi</th>
                        <th>Status Pesan</th>
                        <th>Aksi</th>
                     </tr>
                  </thead>
                  <tbody>
                     <% dataAbsensiSekolah.forEach((data, index) => { %>
                     <tr>
                        <td><%= index + 1 %></td>
                        <td><%= data.siswa?.id_sidik_jari %></td>
                        <td><%= data.siswa?.nama_lengkap %></td>
                        <td><%= data.siswa?.kelas.replace(/_/g, ' ').toUpperCase() %></td>
                        <td>
                           <%= new Date(data.created_at).toLocaleTimeString('id-ID', {
                                 hour: '2-digit',
                                 minute: '2-digit',
                                 hour12: true
                              }) %>
                        </td>
                        <td>
                           <% 
                           const badgeColors = {
                              hadir: 'bg-success',
                              pulang: 'bg-warning'
                           };
                           const color = badgeColors[data.status_siswa];
                           %>
                           <%- color ? `<span class="badge ${color}">${data.status_siswa.charAt(0).toUpperCase() + data.status_siswa.slice(1)}</span>` : '' %>
                        </td>
                        <td>
                           <% 
                           const badgeColors2 = {
                              pending: 'bg-warning',
                              terkirim: 'bg-success',
                              gagal: 'bg-danger'
                           };
                           const color2 = badgeColors2[data.status_pesan];
                           %>
                           <%- color2 ? `<span class="badge ${color2}">${data.status_pesan.charAt(0).toUpperCase() + data.status_pesan.slice(1)}</span>` : '' %>
                        </td>
                        <td>
                           <button type="button"
                              class="btn btn-sm btn-primary btn-icon waves-effect waves-light btn-view"
                              data-id="<%= data.id %>">
                              <i class="ri-eye-2-line"></i>
                           </button>
                        </td>
                     </tr>
                     <% }) %>
                  </tbody>
               </table>
            </div>
         </div>
      </div>
   </div>
</div>

</div>

<script>
   const socket = io();

   function dataAbsensiSekolah(data) {
      const row = document.createElement('tr');
      const badgeColors = {
         hadir: 'bg-success',
         pulang: 'bg-warning'
      };
      const color = badgeColors[data.status_siswa];

      const badgeColors2 = {
         terkirim: 'bg-success',
         pending: 'bg-warning',
         gagal: 'bg-danger'
      };
      const color2 = badgeColors2[data.status_pesan];

      row.innerHTML = `
         <td>${data.id}</td>
         <td>${data.id_sidik_jari}</td>
         <td>${data.nama_lengkap}</td>
         <td>${data.kelas.replace(/_/g, ' ').toUpperCase()}</td>
         <td>${data.waktu}</td>
         <td>
            ${color ? `<span class="badge ${color}">${data.status_siswa.charAt(0).toUpperCase() + data.status_siswa.slice(1)}</span>` : ''}
         </td>
         <td>
            ${color2 ? `<span class="badge ${color2}">${data.status_pesan.charAt(0).toUpperCase() + data.status_pesan.slice(1)}</span>` : ''}
         </td>
         <td>
            <button type="button"
               class="btn btn-sm btn-primary btn-icon waves-effect waves-light btn-view"
               data-id="${data.id}">
               <i class="ri-eye-2-line"></i>
            </button>
         </td>
      `;
      return row;
   }

   function handleFormSubmit(url) {
      const form = document.getElementById('formAbsensiSekolah');

      form.addEventListener('submit', async function onSubmit(e) {
         e.preventDefault();

         const submitBtn = form.querySelector('[type="submit"]');
         const originalBtnHTML = submitBtn.innerHTML

         submitBtn.disabled = true;
         submitBtn.innerHTML = `
            <span class="d-flex align-items-center">
                <span class="spinner-border spinner-border-sm flex-shrink-0" role="status">
                    <span class="visually-hidden">Loading...</span>
                </span>
                <span class="flex-grow-1 ms-2">
                    Loading...
                </span>
            </span>
        `;

         const formData = new FormData(this);
         const data = Object.fromEntries(formData.entries());

         try {
            const res = await fetch(url, {
               method: 'POST',
               headers: {
                  'Content-Type': 'application/json',
               },
               body: JSON.stringify(data)
            });

            document.activeElement?.blur();

            const result = await res.json();
            if (!res.ok) {
               showToastify(result.message, result.type);
               return;
            }

            const modal = bootstrap.Modal.getInstance(document.getElementById('modalAbsensiSekolah'));
            modal.hide();
            form.reset();
         } catch (err) {
            console.error('Gagal menyimpan absensi:', err);
         } finally {
            submitBtn.innerHTML = originalBtnHTML;
            submitBtn.disabled = false;
        }
      });
   }

   socket.on('push:toast', payload => {
      const message = payload.message;
      const type = payload.type;
      showToastify(message, type);
   });

   socket.on('log-absensi:baru', (dataList) => {
      const list = Array.isArray(dataList) ? dataList : [dataList];
      const tbody = document.querySelector('#tableLogAbsensi tbody');
      const fragment = document.createDocumentFragment();

      for (const data of list) {
         const row = dataAbsensiSekolah(data);
         fragment.appendChild(row);
      }

      tbody.prepend(fragment);
   });

   document.addEventListener('DOMContentLoaded', () => {
      const idTable = 'tableLogAbsensi';
      const btnAdd = document.getElementById('btnAbsensiManual');
      const table = document.getElementById(idTable);
      const tableDataSiswa = new DataTable('#' + idTable, {
         scrollX: true,
         order: [0, 'desc'],
         columnDefs: [{
            orderable: false, targets: 7
         }],
      })

      btnAdd.addEventListener('click', async () => {
         const response = await fetch('/absensi-sekolah/create');
         const html = await response.text();
         document.getElementById('modalContainer').innerHTML = html;
         
         $('.select2').select2({
            dropdownParent: $('#modalAbsensiSekolah')
         });
         
         const modal = new bootstrap.Modal(document.getElementById('modalAbsensiSekolah'));
         modal.show();
         
         const select   = document.getElementById('cari_nisn');
         const btnAddSiswa = document.getElementById('btnAddSiswa');
         const tbody    = document.querySelector('#previewTable tbody');
         const hidden   = document.getElementById('hidden_nisn');
         let selectedNisn = [];

         btnAddSiswa.addEventListener('click', async () => {
            const option = select.options[select.selectedIndex];
            if(!option || !option.value) return;

            const nisn  = option.value;
            const nama  = option.dataset.nama;
            const kelas = option.dataset.kelas;
            const wali  = option.dataset.wali;
            const hp    = option.dataset.hp;

            if (selectedNisn.includes(nisn)) return;

            selectedNisn.push(nisn);
            hidden.value = JSON.stringify(selectedNisn);

            const tr = document.createElement('tr');
            tr.innerHTML = `
               <td>${nisn}</td>
               <td>${nama}</td>
               <td>${kelas}</td>
               <td>${wali}</td>
               <td>${hp}</td>
               <td><button type="button" class="btn btn-danger btn-sm btn-remove" data-nisn="${nisn}">Hapus</button></td>
            `;
            tbody.appendChild(tr);

            option.remove();

            select.selectedIndex = 0;
         });

         tbody.addEventListener('click', function(e){
            const btn = e.target.closest('.btn-remove');
            if(!btn) return;

            const nisn = btn.dataset.nisn;
            selectedNisn = selectedNisn.filter(n => n !== nisn);
            hidden.value = JSON.stringify(selectedNisn);

            const tr = btn.closest('tr');

            const nama  = tr.children[1].textContent;
            const kelas = tr.children[2].textContent;
            const wali  = tr.children[3].textContent;
            const hp    = tr.children[4].textContent;

            const newOpt = document.createElement('option');
            newOpt.value = nisn;
            newOpt.textContent = `${nama} (${kelas})`;

            newOpt.dataset.nama  = nama;
            newOpt.dataset.kelas = kelas;
            newOpt.dataset.wali  = wali;
            newOpt.dataset.hp    = hp;

            select.appendChild(newOpt);

            select.selectedIndex = 0;

            tr.remove();
         });
         
         handleFormSubmit('/absensi-sekolah');
      });

      table.addEventListener('click', async (e) => {
         const btn = e.target.closest('.btn-view');
         if (btn) {
            const id = btn.getAttribute('data-id');
            const response = await fetch('/absensi-sekolah/lihat-data/' + id);
            const html = await response.text();
            document.getElementById('modalContainer').innerHTML = html;

            $('.select2').select2({
               dropdownParent: $('#modalAbsensiSekolah')
            });

            const modal = new bootstrap.Modal(document.getElementById('modalAbsensiSekolah'));
            modal.show();
         }
      })

   });

</script>
